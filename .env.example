# Server Configuration
SYNAPSE_HTTP_PORT=127.0.0.1:8080
SYNAPSE_MQTT_PORT=127.0.0.1:1883
SYNAPSE_WS_PORT=127.0.0.1:8083
SYNAPSE_DB_PATH=synapse.db

# Security
# Set two distinct random secrets; startup rejects empty/equal values.
SYNAPSE_AUTH_TOKEN=
SYNAPSE_ADMIN_TOKEN=
# Set true when serving through an HTTPS reverse proxy.
SYNAPSE_COOKIE_SECURE=false

# SMTP Notifications (Optional)
SYNAPSE_ENABLE_ALERTS=false
SYNAPSE_SMTP_HOST=smtp.example.com
SYNAPSE_SMTP_PORT=587
SYNAPSE_SMTP_USER=notify@example.com
SYNAPSE_SMTP_PASS=your-password
SYNAPSE_SMTP_FROM=synapse@example.com
SYNAPSE_SMTP_TO=admin@example.com
